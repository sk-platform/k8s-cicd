{
  "name": "k8s-cicd",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-environment CI/CD with GitHub Actions: build a container image once, deploy it to dev, staging and production through one reusable workflow, and promote the tested image to production behind an approval gate.",
  "keywords": [
    "github-actions",
    "cicd",
    "ci-cd-pipeline",
    "multi-environment-deployment",
    "reusable-workflows",
    "workflow-call",
    "deployment-automation",
    "release-drafter",
    "semantic-versioning",
    "ghcr",
    "container-registry",
    "docker",
    "kubernetes",
    "argocd",
    "gitops",
    "devops",
    "platform-engineering",
    "nextjs"
  ],
  "homepage": "https://sk-santhosh.info/blogs/from-branch-to-production-multi-env-deployment-automation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sk-platform/k8s-cicd.git"
  },
  "bugs": "https://github.com/sk-platform/k8s-cicd/issues",
  "license": "MIT",
  "author": "Santhosh J",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"lib/**/*.test.ts\"",
    "verify": "npm run lint && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
